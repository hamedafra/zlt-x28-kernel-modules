#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99
PROG="/data/sing-box/sing-box"

start_service() {
  config_load "sing-box"

  local enabled config_file working_directory
  local log_stderr
  config_get_bool enabled "main" "enabled" "0"
  [ "$enabled" -eq "1" ] || return 0

  config_get config_file "main" "conffile" "/data/sing-box/config.json"
  config_get working_directory "main" "workdir" "/data/sing-box"
  config_get_bool log_stderr "main" "log_stderr" "1"

  procd_open_instance
  procd_set_param command "$PROG" run -c "$config_file" -D "$working_directory"
  procd_set_param file "$config_file"
  procd_set_param stderr "$log_stderr"
  procd_set_param limits core="unlimited"
  procd_set_param limits nofile="1000000 1000000"
  procd_set_param env GOMEMLIMIT=50MiB GOGC=25 GODEBUG=madvdontneed=1
  procd_set_param respawn

  procd_close_instance
}

# TCP from the LAN reaches the "redirect" inbound through iptables (see /etc/sing-box-redirect.sh)
service_started() {
  [ "$(uci -q get sing-box.main.enabled)" = "1" ] && /etc/sing-box-redirect.sh apply
}

service_stopped() {
  /etc/sing-box-redirect.sh remove
}

service_triggers() {
  procd_add_reload_trigger "sing-box"
}
